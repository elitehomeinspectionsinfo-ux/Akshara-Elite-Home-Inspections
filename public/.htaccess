# Apache config for Hostinger. Vite copies this file into dist/ on build.

Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Send http:// and bare aksharainspections.com to https://www.aksharainspections.com
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.aksharainspections.com%{REQUEST_URI} [L,R=301]

  # Single-page app: serve index.html for any path that isn't a real file,
  # so /about, /services etc. work when opened directly or refreshed.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # Built JS/CSS have a content hash in their names, so they can be cached for a year.
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|png|jpe?g|webp|avif|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Always check for a fresh index.html so new deploys show up right away.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
